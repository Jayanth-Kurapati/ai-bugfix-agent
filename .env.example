# AI Bug-Fixing Agent — Environment Variables
#
# Copy this file to .env and fill in the required values.
# Never commit a real .env file — it is excluded by .gitignore.

# Required: your OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-key-here

# Optional: override the OpenRouter base URL (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
